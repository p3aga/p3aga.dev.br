---
import { Font } from "astro:assets";
import type { Props as HeadProps } from "@/components/BaseHead.astro";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import siteConfig from "@/site.config";

import "@/styles/global.css";

interface Props extends HeadProps {}

const props = Astro.props;
---

<html lang={siteConfig.Lang} class="scroll-smooth">
	<head>
    <BaseHead {...props} />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-playfair-display" />
    <Font cssVariable="--font-noto-serif" />
    <script is:inline>
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      const handleTheme = (() => {
        const theme = localStorage.getItem('theme') || (mediaQuery.matches ? 'dark' : 'light');
        if (theme == 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      });

      mediaQuery.addEventListener('change', handleTheme);
      handleTheme();
    </script>
	</head>
  <body class="transition-colors duration-500 bg-green-50 text-green-900 dark:bg-green-950 dark:text-green-50">
    <div class="m-auto w-auto px-5 sm:w-xl sm:px-0">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
	</body>
</html>
