---
import { Icon } from "astro-icon/components";

const { page } = Astro.props;
---

<div class={`flex ${page.url.prev ? 'justify-between' : 'justify-end'}`}>
  { page.url.prev && (
    <a href={ page.url.prev } class="flex items-center justify-start font-bold">
      <Icon name="ui/arrow-left" class="me-1" /> Anterior
    </a>
  )}
  { page.url.next && (
    <a href={ page.url.next } class="flex items-center justify-end font-bold">
      Próxima <Icon name="ui/arrow-right" class="ms-1" />
    </a>
  )}
</div>
