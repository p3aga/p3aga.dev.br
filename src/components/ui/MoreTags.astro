---
import { Icon } from "astro-icon/components";

export interface Props {
  tags: {
    name: string;
    postCount: number;
  }[];
  collection?: "blog" | "projects" | (string & {});
}

const { tags, collection = "blog" } = Astro.props;

const base_resource = collection === "blog" ? "/tags" : "/projects/tags";
---

{tags.length > 0 && (
  <div class="pb-3">
    <h2 class="text-lg font-serif font-extrabold">Principais tags</h2>
  </div>
  <div class="ms-1">
    <div>
      <ul>
        {tags.map(tag => (
          <li class="mb-1 cursor-pointer">
            <a href={`${base_resource}/${tag.name}`}>
              <b class="font-mono font-semibold me-1">#{tag.name}</b>
              <span class="opacity-50 text-xs">{tag.postCount} posts</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="pt-1">
      <a href={base_resource} class="font-serif text-sm font-base">
        Ver todas as tags <Icon name="ui/move-right" class="inline-block" />
      </a>
    </div>
  </div>
)}
