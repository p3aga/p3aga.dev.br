---
import { Icon } from "astro-icon/components";
---

<button id="openSearchModal" class="flex items-center cursor-pointer" type="button">
  <Icon name="ui/search" class="text-xl" />
</button>
<dialog id="searchModal" class="m-auto mt-8 w-full max-h-[80dvh] overflow-hidden rounded-md bg-green-50 text-green-900 open:flex open:flex-col focus:outline-hidden backdrop:bg-neutral-900/50 sm:w-lg dark:bg-neutral-800 dark:text-neutral-50">
  <div class="flex items-center relative shrink-0">
    <label for="searchInput" class="absolute left-2 cursor-pointer">
      <Icon name="ui/search" class="text-2xl" />
    </label>
    <input id="searchInput" placeholder="Pesquisar..." type="text" class="text-2xl align-baseline w-full px-10 py-2 focus:outline-hidden">
    <button id="closeSearchModal" type="button" class="absolute right-2">
      <Icon name="ui/close" class="text-2xl cursor-pointer" />
    </button>
  </div>
  <div id="searchResults" class="flex-1 min-h-0 overflow-y-auto scrollbar-thin"></div>
  <div id="searchKeys" class="text-xs space-x-1 m-2">
    <span><code>↓</code><code>↑</code>Navegar</span>
    <span><code>↲</code>Selecionar</span>
    <span><code>esc</code>Fechar</span>
  </div>

  <template id="searchResultItemTemplate">
    <li>
      <a class="result-link block mx-2 py-2 px-3 border border-green-900/30 rounded hover:bg-green-900/10 dark:border-neutral-50/15 dark:hover:bg-neutral-50/5">
        <h3 class="result-title font-bold text-base"></h3>
        <p class="result-excerpt text-xs line-clamp-2"></p>
      </a>
    </li>
  </template>
</dialog>

<style is:global>
  #searchModal {
    box-shadow: 0px 0px 5px var(--color-neutral-950);
  }

  .result-excerpt > mark {
    background-color: transparent;
    font-weight: var(--font-weight-semibold);
    color: var(--color-green-900);
  }

  :where(.dark) .result-excerpt > mark {
    color: var(--color-neutral-50);
  }

  .result-link.active {
    background-color: color-mix(in srgb, var(--color-green-900) 10%, transparent);
    outline: 1px solid var(--color-green-900);
  }

  :where(.dark) .result-link.active {
    background-color: color-mix(in srgb, var(--color-neutral-50) 10%, transparent);
    outline: 1px solid var(--color-neutral-50);
  }

  #searchKeys code {
    font-family: var(--font-mono);
    background-color: color-mix(in srgb, var(--color-green-900) 10%, transparent);
    border: 1px solid var(--color-green-900);
    border-radius: 4px;
    box-sizing: border-box;
    margin-inline-end: 2px;
    padding-inline: 5px;
    padding-block: 1px;
  }

  :where(.dark) #searchKeys code {
    background-color: color-mix(in srgb, var(--color-neutral-50) 10%, transparent);
    border: 1px solid var(--color-neutral-50);
  }
</style>

<script>
  import { toggleBodyOverflowHidden } from '@/scripts/dom.ts';

  const openSearchModal = document.querySelector('#openSearchModal');
  const closeSearchModal = document.querySelector('#closeSearchModal');
  const searchModal = document.querySelector<HTMLDialogElement>('#searchModal');
  const searchInput = document.querySelector<HTMLInputElement>('#searchInput');
  const searchResults = document.querySelector('#searchResults');
  const template = document.querySelector<HTMLTemplateElement>('#searchResultItemTemplate');

  let selectedIndex = -1;

  const getResultLinks = (): HTMLAnchorElement[] => {
    if (!searchResults) return [];
    return Array.from(searchResults.querySelectorAll<HTMLAnchorElement>('.result-link'));
  };

  const updateActiveItem = (links: HTMLAnchorElement[]) => {
    links.forEach((link, idx) => {
      const isActive = idx === selectedIndex;
      link.classList.toggle('active', isActive);
      link.setAttribute('aria-selected', isActive ? 'true' : 'false');

      if (isActive) {
        link.scrollIntoView({ block: 'nearest' });
      }
    });
  };

  const cleanSearch = () => {
    if (searchInput) searchInput.value = '';
    selectedIndex = -1;
    searchResults?.replaceChildren();
  }

  const openModal = () => {
    toggleBodyOverflowHidden();
    searchModal?.showModal();
    searchInput?.focus();
  }

  openSearchModal?.addEventListener('click', openModal);

  closeSearchModal?.addEventListener('click', () => {
    cleanSearch();
    searchModal?.close();
  });

  searchModal?.addEventListener('cancel', () => {
    cleanSearch();
    searchResults?.replaceChildren();
  })

  searchModal?.addEventListener('keydown', (e: KeyboardEvent) => {
    const links = getResultLinks();
    if (links.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % links.length;
      updateActiveItem(links);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + links.length) % links.length;
      updateActiveItem(links);
    } else if (e.key === 'Enter' && selectedIndex >= 0) {
      e.preventDefault();
      links[selectedIndex]?.click();
    }
  });

  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openModal();
    }
  });

  if (process.env.NODE_ENV === "production") {
    const pagefindPath = "/pagefind/pagefind.js";
    const pagefind = await import(/* @vite-ignore */ pagefindPath);

    searchModal?.addEventListener('close', () => {
      toggleBodyOverflowHidden();
    });

    const renderResults = (results: any[]) => {
      if (!searchResults || !template) return;
      searchResults.replaceChildren();
      selectedIndex = -1;

      const fragment = document.createDocumentFragment();
      const ul = document.createElement("ul");
      ul.className = "flex flex-col gap-2 my-2";

      let totalItems = 0;

      results.forEach((result) => {
        const pageTitle = result.meta.title;

        result.sub_results.forEach((subResult: any) => {
          totalItems++;

          const clone = template.content.cloneNode(true) as DocumentFragment;
          const link = clone.querySelector(".result-link") as HTMLAnchorElement | null;
          const title = clone.querySelector(".result-title");
          const excerpt = clone.querySelector(".result-excerpt");

          if (link) link.href = subResult.url;
          if (title) title.textContent = `${pageTitle} > ${subResult.title}`;
          if (excerpt) excerpt.innerHTML = subResult.excerpt;

          ul.appendChild(clone);
        });
      });

      if (totalItems === 0) {
        const empty = document.createElement("p");
        empty.className = "text-sm mx-2 p-2";
        empty.textContent = "Nenhum resultado encontrado.";
        searchResults?.appendChild(empty);
        return;
      }

      fragment.appendChild(ul);
      searchResults.appendChild(fragment);
    };

    searchResults?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.result-link');
      if (!target) return;

      cleanSearch();
      searchModal?.close();
    });

    searchInput?.addEventListener("input", async (e) => {
      const target = e.target as HTMLInputElement;
      const query = target.value.trim();

      const search = await pagefind.debouncedSearch(query, 300);
      if (search === null || !query) {
        searchResults?.replaceChildren();
        return;
      }
      const results = await Promise.all(search.results.map((r: any) => r.data()))
      renderResults(results);
    });
  }
</script>
