---
import { Icon } from 'astro-icon/components';
import siteConfig from "@/site.config";
---

<footer class="flex justify-between mt-15 mb-5 text-center">
  <div class="text-base font-serif text-medium">
    <small>Copyright © {siteConfig.Author.Name} {siteConfig.Author.Year}</small>
  </div>
  <div class="flex items-center gap-3">
    {siteConfig.UserLinks.map((link) => (
      <a href={link.url} target="_blank" aria-label={link.type}>
        <Icon name={`logos/${link.type}`} class=""/>
      </a>
    ))}
  </div>
</footer>
