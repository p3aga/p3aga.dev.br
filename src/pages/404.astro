---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="Página não existe">
  <div class="flex justify-center items-center min-h-[calc(100dvh-18rem)] sm:min-h-[calc(100dvh-16rem)]">
    <div class="flex flex-col items-center -mt-60">
      <span class="text-7xl font-bold font-title">404</span>
      <span class="text-lg font-semibold font-serif mt-5">Esta página não existe</span>
    </div>
  </div>
</BaseLayout>
