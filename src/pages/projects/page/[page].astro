---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import MoreTags from "@/components/ui/MoreTags.astro";
import PageToggle from "@/components/ui/PageToggle.astro";
import PostPreview from "@/components/ui/PostPreview.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMoreTags, getProjectPosts } from "@/scripts/projects";
import siteConfig from "@/site.config";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = await getProjectPosts();

  return paginate(allPostsByDate, {
    pageSize: 10,
  });
};

export interface Props {
  page: Page<CollectionEntry<"projects">>;
}

const { page } = Astro.props;

const tags = await getMoreTags();

const hasContent = page.total > 0;
---

<BaseLayout title="Posts" description={`${siteConfig.SiteName} Projects - page ${page.currentPage}`} nodata={!hasContent}>
  <section class:list={[`${page.url.prev} ? 'mb-10' : ''`, 'relative']}>
    <h1 class="font-serif text-3xl font-extrabold leading-10 mt-0 mb-8">
      Projetos
    </h1>
    <div>
      {page.data.map((post) => <PostPreview post={post} />)}
    </div>
    <PageToggle page={ page } />
  </section>
  <div slot="aside-right" class="sticky top-14"><MoreTags tags={tags} collection="projects" /></div>
  {tags.length > 0 && (
    <hr class="block opacity-30 my-6 lg:hidden">
    <div class="block lg:hidden"><MoreTags tags={tags} collection="projects" /></div>
  )}
</BaseLayout>
