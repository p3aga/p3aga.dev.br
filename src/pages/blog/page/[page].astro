---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import PageToggle from "@/components/ui/PageToggle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getOrderedBlogPosts } from "@/scripts/blog";
import siteConfig from "@/site.config";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = await getOrderedBlogPosts();

  return paginate(allPostsByDate, {
    pageSize: 1,
  });
};

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<BaseLayout title="Posts" description={`${siteConfig.SiteName} Blog posts - page ${page.currentPage}`}>
  <section class:list={[`${page.url.prev} ? 'mb-10' : ''`, 'relative']}>
    <h1 class="font-serif text-4xl font-extrabold leading-10 mt-0 mb-8">
      Posts
    </h1>
    <div>
      {page.data.map((post) => <PostPreview post={post} />)}
    </div>
    <PageToggle page={ page } />
  </section>
</BaseLayout>
