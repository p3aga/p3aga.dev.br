---
import { getEntry, render } from "astro:content";
import PostPreview from "@/components/ui/PostPreview.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getOrderedBlogPosts } from "@/scripts/blog";

const entry = await getEntry("pages", "index");
if (!entry) {
  throw new Error("Index page not found (file: src/content/pages/index.md)");
}
const { Content } = await render(entry);
const recentPosts = (await getOrderedBlogPosts()).slice(0, 5);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  >
  <article class="prose">
    <div class="mb-8">
      <h1 class="text-2xl mb-0">{entry.data.title}</h1>
      <span class="text-sm opacity-70">{entry.data.description}</span>
    </div>
    <Content />
  </article>
  { recentPosts.length > 0 && (
    <div class="mt-8">
      <h2 class="text-2xl font-serif font-bold">Posts recentes</h2>
      <div>
        {recentPosts.map(post => <PostPreview post={post} />)}
      </div>
    </div>
  )}
</BaseLayout>
