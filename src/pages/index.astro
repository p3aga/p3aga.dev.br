---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const entry = await getEntry("pages", "index");
if (!entry) {
  throw new Error("Index page not found (file: src/content/pages/index.md)");
}
const { Content } = await render(entry);
---

<BaseLayout
  title="Sobre DevOps, Linux, Desenvolvimento e a Vida"
  description="Artigos, tutoriais práticos de TI e de vez em quando alguns desabafos"
  >
  <h1>Welcome to My Astro Site</h1>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
